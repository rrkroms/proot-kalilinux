data_entry(){
# Default data file
DEFAULT_DATA_FILE="data.txt"
echo $1 $2
# Check if user provided -f option with a file or -d option with data
if [[ $1 == "-f" && -f $2 ]]; then
    # User provided -f option with a valid file
    DATA_SOURCE="$2"
elif [[ $1 == "-d" && -n $2 ]]; then
    # User provided -d option with data
    DATA_SOURCE="/dev/stdin"
else
    echo "Invalid option or missing data source."
    exit 1
fi

# Function to check if data exists in the default data file
data_exists() {
    local data="$1"
    grep -Fxq "$data" "$DEFAULT_DATA_FILE"
}

# Function to add data to the default data file
add_data() {
    local data="$1"
    echo "$data" >> "$DEFAULT_DATA_FILE"
}

# Array to store unique data
unique_data=()

# Read data from the data source
while read -r data; do
    # Remove leading/trailing whitespace
    data=$(echo "$data" | awk '{$1=$1;print}')

    # Check if data is already in the array or in the default data file
    if ! [[ " ${unique_data[@]} " =~ " ${data} " ]] && ! data_exists "$data"; then
        # Add data to the array and default data file
        unique_data+=("$data")
	echo $data
        add_data "$data"
    fi
done < "$DATA_SOURCE"

# Print the unique data
echo "Unique data:"
for data in "${unique_data[@]}"; do
    echo "$data"
done
$@
}
